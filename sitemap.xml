---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for item in site.pages %}
    {% unless item.noindex %}
      {% if item.url contains '.html' or item.url == '/' %}
        <url>
          <loc>{{ item.url | absolute_url }}</loc>
        </url>
      {% endif %}
    {% endunless %}
  {% endfor %}
</urlset>
